# =====================================================
# AssemblyOps Backend Environment Variables
# =====================================================
# Reference only — do NOT copy this to a .env file.
#
# Railway is the source of truth for every value below, in both the
# `production` and `development` environments. Nothing is stored on disk.
#
#   Local dev:  npm run dev   (wraps scripts/railway-dev.sh -> railway run)
#   New machine: railway login && railway link
#
# This file exists to document which keys the app expects. Add a key here
# whenever you add one in Railway, so the list stays reviewable in git.

# =====================================================
# Database Configuration
# =====================================================
# Postgres 18 runs as a Railway service, one per environment.
#   Deployed services -> postgres.railway.internal (private networking)
#   Local machines    -> public TCP proxy, exposed as DATABASE_PUBLIC_URL
#
# railway-dev.sh remaps DATABASE_PUBLIC_URL onto both vars below for local
# runs, since the internal host only resolves inside Railway.
#
# DATABASE_URL is used at runtime; DIRECT_URL by Prisma migrations
# (see prisma.config.ts). On Railway both point at the same host — the split
# is a leftover from Neon's pooler and no longer means anything.
DATABASE_URL=postgresql://user:password@host:port/railway
DIRECT_URL=postgresql://user:password@host:port/railway

# Railway Postgres terminates SSL → true.
DATABASE_SSL=true

# =====================================================
# JWT Authentication
# =====================================================
# Secret key for signing JWT access tokens (min 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-very-secure-jwt-secret-key-at-least-32-characters-long

# Secret key for signing JWT refresh tokens (min 32 characters, must be different from JWT_SECRET)
# Generate with: openssl rand -base64 32
JWT_REFRESH_SECRET=your-very-secure-refresh-secret-key-at-least-32-characters-long

# =====================================================
# Volunteer Authentication
# =====================================================
# Secret key for encrypting volunteer credentials/tokens (32 bytes hex)
# Generate with: openssl rand -hex 32
VOLUNTEER_TOKEN_KEY=your-64-character-hex-key-for-volunteer-token-encryption

# =====================================================
# PII Encryption
# =====================================================
# Secret key for encrypting personally identifiable information (32 bytes hex)
# Generate with: openssl rand -hex 32
PII_ENCRYPTION_KEY=your-64-character-hex-key-for-encrypting-personal-data

# =====================================================
# OAuth Configuration (Optional)
# =====================================================
# Google OAuth 2.0 Client ID (for Sign in with Google)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Apple OAuth Client ID (for Sign in with Apple)
# Get from: https://developer.apple.com/account/resources/identifiers/list/serviceId
APPLE_CLIENT_ID=com.yourapp.services

# =====================================================
# Server Configuration
# =====================================================
# Port for the server to listen on
PORT=4000

# Node environment (development, production, test)
NODE_ENV=development

# =====================================================
# CORS Configuration
# =====================================================
# Comma-separated list of allowed origins for CORS
# Default allows localhost for development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# Cloudflare R2 (S3-compatible) — floor plan image storage
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_BUCKET=assemblyops-floorplans
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=