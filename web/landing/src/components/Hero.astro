---
// Hero.astro — above-the-fold hero: launch badge, headline, subheadline, waitlist CTA.
---

<section class="hero">
  <div class="container">
    <span class="badge">Launching Fall 2026</span>
    <h1 class="headline">Assembly management, <br />simplified</h1>
    <p class="subheadline">
      The all-in-one platform for organizing departments, assigning volunteers,
      and tracking attendance at assemblies and conventions.
    </p>
    <!-- TODO: Add link once available in future issue -->
    <a class="btn" href="#" target="_blank" rel="noopener noreferrer">
      Join the waitlist
    </a>
  </div>
</section>

<style>
  .hero {
    padding-top: 120px;
    min-height: 80vh;
    display: flex;
    align-items: center;
  }
  .container {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding: 24px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--primary);
    background: var(--primary-light);
    padding: 6px 14px;
    border-radius: 100px;
    margin-bottom: 20px;
  }
  .headline {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--primary);
    margin-bottom: 16px;
  }
  .subheadline {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 560px;
    margin: 0 auto 32px;
  }
  .btn {
    display: inline-block;
    font-family: var(--font-dm-sans);
    font-weight: 500;
    text-decoration: none;
    border: none;
    cursor: pointer;
    border-radius: var(--radius-btn);
    transition: background 0.2s;
    background: var(--primary);
    color: #ffffff;
    padding: 14px 28px;
    font-size: 1rem;
  }
  .btn:hover {
    background: var(--primary-tint);
  }
  .btn:focus-visible {
    outline: 3px solid var(--primary-tint);
    outline-offset: 3px;
  }
  @media (min-width: 640px) {
    .headline {
      font-size: 3.25rem;
    }
    .subheadline {
      font-size: 1.25rem;
    }
  }
</style>
